# Copy to .env for local development. Never commit .env.
# All settings are optional locally; the defaults below are what the process uses.

# local | dev | staging | prod
GATEWAY_ENVIRONMENT=local

# DEBUG | INFO | WARNING | ERROR | CRITICAL
GATEWAY_LOG_LEVEL=INFO

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000

# SQLite is the v0.1 default. PostgreSQL is supported without domain changes:
#   postgresql+psycopg://user:password@host:5432/gateway
GATEWAY_DATABASE_URL=sqlite+pysqlite:///./gateway.db

# Echo SQL to the log. Never enable outside local debugging: statements can
# carry parameter values.
GATEWAY_DATABASE_ECHO=false

# Deployment-specific key for hashing request inputs and outputs. Inputs and
# outputs are stored only as keyed digests; an UNKEYED hash of a short prompt is
# trivially reversible by brute force, so this key is what makes the privacy
# guarantee hold. The process REFUSES TO START in staging or prod while this is
# left at its development default.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_HASH_KEY=local-development-hash-key

# Set to run the PostgreSQL half of the test matrix. Tests skip it when unset.
# GATEWAY_TEST_POSTGRES_URL=postgresql+psycopg://gateway:gateway@127.0.0.1:55432/gateway_test

# Provider credentials are NOT used before M4 and must never be required by the
# default test suite.
