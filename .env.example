# Copy to .env for local development. Never commit .env.
# All settings are optional; the defaults below are what the process uses.

# local | dev | staging | prod
GATEWAY_ENVIRONMENT=local

# DEBUG | INFO | WARNING | ERROR | CRITICAL
GATEWAY_LOG_LEVEL=INFO

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000

# Provider credentials are NOT used in M0 and must never be required by the
# default test suite. They arrive with M4.
